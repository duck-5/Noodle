{
  "manifest_version": 3,
  "name": "Noodle",
  "key": "",
  "version": "3.2.0",
  "description": "Direct client-side sync of Moodle assignments and grades to Google Tasks",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "identity",
    "webRequest",
    "cookies"
  ],
  "host_permissions": [
    "*://moodle.tau.ac.il/*",
    "*://nidp.tau.ac.il/*",
    "*://tau.ac.il/*",
    "https://accounts.google.com/*",
    "https://tasks.googleapis.com/*",
    "https://www.googleapis.com/*",
    "https://applications.zoom.us/*"
  ],
  "background": {
    "service_worker": "src/background/serviceWorker.ts",
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "noodle@tau",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "oauth2": {
    "client_id": "510394355212-0e3ums7pu5raagej4gg14nrkt9o06m78.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/tasks"
    ]
  },
  "options_page": "options.html"
}
